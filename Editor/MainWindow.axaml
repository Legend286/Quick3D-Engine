<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Engine.Editor.ViewModels"
        xmlns:views="using:Engine.Editor.Views"
        xmlns:behaviors="using:Engine.Editor.Behaviors"
        x:Class="Engine.Editor.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        FontFamily="-apple-system,Segoe UI,Helvetica,Arial,sans-serif"
        FontSize="13"
        Background="#12151c"
        TransparencyLevelHint="None"
        Title="{Binding WindowTitle}">

  <Window.Styles>
    <!-- Ensure all Expanders in the window stretch to full width -->
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>

  <Grid x:Name="RootLayout" RowDefinitions="Auto,*,Auto">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="480" />
      <ColumnDefinition Width="4" />
      <ColumnDefinition Width="*" MinWidth="300" />
      <ColumnDefinition Width="4" />
      <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="480" />
    </Grid.ColumnDefinitions>

    <!-- Top menu bar -->
    <Menu Grid.Row="0" Grid.ColumnSpan="5" FontSize="13">
      <MenuItem Header="_File">
        <MenuItem Header="_New Project…" Click="OnNewProjectClicked">
          <MenuItem.Icon><TextBlock Text="&#xE2CC;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Open Project…" Click="OnOpenProjectClicked">
          <MenuItem.Icon><TextBlock Text="&#xE2C8;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="_New Scene" Click="OnNewSceneClicked">
          <MenuItem.Icon><TextBlock Text="&#xE145;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Open Scene…" Click="OnOpenSceneClicked">
          <MenuItem.Icon><TextBlock Text="&#xE2C7;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Save Scene" Click="OnSaveSceneClicked">
          <MenuItem.Icon><TextBlock Text="&#xE161;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Save Scene _As…" Click="OnSaveSceneAsClicked">
          <MenuItem.Icon><TextBlock Text="&#xE161;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="E_xit" Click="OnExitClicked">
          <MenuItem.Icon><TextBlock Text="&#xE879;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding Commands.UndoLabel}"
                  IsEnabled="{Binding Commands.CanUndo}"
                  Click="OnUndoClicked">
          <MenuItem.Icon><TextBlock Text="&#xE166;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{Binding Commands.RedoLabel}"
                  IsEnabled="{Binding Commands.CanRedo}"
                  Click="OnRedoClicked">
          <MenuItem.Icon><TextBlock Text="&#xE15A;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Delete"
                  Click="OnDeleteEntityClicked">
          <MenuItem.Icon><TextBlock Text="&#xE872;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Window">
        <MenuItem Header="_Reset Layout">
          <MenuItem.Icon><TextBlock Text="&#xE8D5;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Plugins…" Click="OnPluginsClicked">
          <MenuItem.Icon><TextBlock Text="&#xE87B;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Material Editor">
          <MenuItem.Icon><TextBlock Text="&#xE3F4;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Model Viewer">
          <MenuItem.Icon><TextBlock Text="&#xE8B2;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Particle Editor">
          <MenuItem.Icon><TextBlock Text="&#xE3E3;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Level Editor">
          <MenuItem.Icon><TextBlock Text="&#xE8D5;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- Populated by MainWindow.RebuildDynamicToolsMenu from DynamicMenuService. -->
        <MenuItem x:Name="ExtensionsToolsMenuItem"
                  Header="_Extensions"
                  IsVisible="False" />
      </MenuItem>
      <MenuItem Header="_Hot Reload" Click="OnHotReloadClicked" FontWeight="Bold" Foreground="#32cd32">
        <MenuItem.Icon><TextBlock Text="&#xE5D5;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" Foreground="#32cd32" /></MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About">
          <MenuItem.Icon><TextBlock Text="&#xE887;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
    </Menu>

    <!-- Left rail: Hierarchy / Inspector -->
    <TabControl Grid.Row="1" Grid.Column="0"
                MinWidth="200" MaxWidth="480"
                Margin="4">
      <TabItem Header="Hierarchy">
        <Border Padding="8">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,8">
              <Button Content="+ Create"
                      HorizontalAlignment="Stretch">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="Empty Entity"
                              Click="OnCreateEmptyEntityClicked">
                      <MenuItem.Icon><TextBlock Text="&#xE8CC;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Camera"
                              Click="OnCreateCameraClicked">
                      <MenuItem.Icon><TextBlock Text="&#xE412;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Light">
                      <MenuItem.Icon><TextBlock Text="&#xE42A;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
                      <MenuItem Header="Directional Light"
                                Click="OnAddDirectionalLightClicked">
                        <MenuItem.Icon><TextBlock Text="&#xE518;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Point Light"
                                Click="OnAddPointLightClicked">
                        <MenuItem.Icon><TextBlock Text="&#xE42A;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Spot Light"
                                Click="OnAddSpotLightClicked">
                        <MenuItem.Icon><TextBlock Text="&#xE872;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" /></MenuItem.Icon>
                      </MenuItem>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Grid.Column="1"
                      Width="30"
                      Margin="6,0,0,0"
                      Content="&#xe872;"
                      FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons"
                      ToolTip.Tip="Delete selected entity"
                      Click="OnDeleteEntityClicked" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding HierarchyVm.Entities}" SelectedItem="{Binding HierarchyVm.SelectedEntity}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </TabItem>
    </TabControl>

    <!-- Drag handle between left rail and viewport -->
    <GridSplitter Grid.Row="1" Grid.Column="1"
                  Width="4"
                  HorizontalAlignment="Stretch"
                  ResizeDirection="Columns"
                  ShowsPreview="False"
                  Background="#1c1f24" />

    <!-- Center: viewport on top, collapsable consoles on the bottom -->
    <Grid Grid.Row="1" Grid.Column="2" Margin="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="150" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <views:ViewportPanelView Grid.Row="0" DataContext="{Binding ViewportVm}" />

      <!-- Divider & Toggle Bar -->
      <Border Grid.Row="1" Background="#1c1f24" Height="28" BorderBrush="#2d3139" BorderThickness="0,1" Margin="0,4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="BOTTOM PANELS" Foreground="#aab0b6" VerticalAlignment="Center" Margin="8,0" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.05" />
          <Button Grid.Column="1" Width="28" Height="24" Background="Transparent" BorderThickness="0" Padding="0" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,4,0" Click="OnToggleConsoleClicked" ToolTip.Tip="Toggle Bottom Panel">
            <Button.Styles>
              <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#2d3139" />
              </Style>
              <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#3e4451" />
              </Style>
            </Button.Styles>
            <TextBlock x:Name="ConsoleCollapseIcon" Text="&#xe313;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" FontSize="18" Foreground="#aab0b6" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Border>

      <TabControl x:Name="ConsolesTabControl" Grid.Row="2"
                  MinHeight="80" MaxHeight="800"
                  Height="375" IsVisible="True">
        <TabItem Header="Content Browser">
          <views:ContentBrowserView DataContext="{Binding ContentBrowserVm}" />
        </TabItem>
        <TabItem Header="Console">
          <views:ConsolePanelView DataContext="{Binding ConsoleVm}" />
        </TabItem>
        <TabItem Header="Render Graph">
          <views:RenderGraphExplorerView DataContext="{Binding RenderGraphVm}" />
        </TabItem>
        <TabItem Header="Localization">
          <Border Padding="8">
            <TextBlock Text="(empty - Phase 4)" FontSize="13" />
          </Border>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Drag handle between viewport and right rail -->
    <GridSplitter Grid.Row="1" Grid.Column="3"
                  Width="4"
                  HorizontalAlignment="Stretch"
                  ResizeDirection="Columns"
                  ShowsPreview="False"
                  Background="#1c1f24" />

    <!-- Right rail: Inspector -->
    <Border Grid.Row="1" Grid.Column="4" MinWidth="200" MaxWidth="480" Margin="4" Background="#1c1f24" BorderBrush="#2d3139" BorderThickness="1" CornerRadius="4">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#2d3139" Padding="10,6" CornerRadius="4,4,0,0">
          <TextBlock Text="Inspector" FontWeight="Bold" Foreground="#e0e0e0" />
        </Border>
        <Border Grid.Row="1" Padding="8" DataContext="{Binding InspectorVm}">
          <ScrollViewer>
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding EntityName}" FontWeight="Bold" FontSize="16" />
              
              <Border IsVisible="{Binding !HasSelection}" Padding="10" Background="#2d3139" CornerRadius="4">
                <TextBlock Text="Select an entity to view its properties." FontStyle="Italic" Foreground="#aab0b6" />
              </Border>
              
              <!-- Transform Component -->
              <Expander Header="Transform" IsVisible="{Binding HasTransform}" IsExpanded="True">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Position" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="0,0,0,5">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,4,0">
                      <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" Foreground="#ff6b6b" Margin="0,0,4,0"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding PosX, TargetNullValue=0, FallbackValue=0}" Increment="0.1" FormatString="0.00" HorizontalAlignment="Stretch" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    </Grid>
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,0,4,0">
                      <TextBlock Grid.Column="0" Text="Y" VerticalAlignment="Center" Foreground="#51cf66" Margin="0,0,4,0"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding PosY, TargetNullValue=0, FallbackValue=0}" Increment="0.1" FormatString="0.00" HorizontalAlignment="Stretch" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    </Grid>
                    <Grid Grid.Column="2" ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Text="Z" VerticalAlignment="Center" Foreground="#339af0" Margin="0,0,4,0"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding PosZ, TargetNullValue=0, FallbackValue=0}" Increment="0.1" FormatString="0.00" HorizontalAlignment="Stretch" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    </Grid>
                  </Grid>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotation" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="0,0,0,5">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,4,0">
                      <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" Foreground="#ff6b6b" Margin="0,0,4,0"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding RotX, TargetNullValue=0, FallbackValue=0}" Increment="1" FormatString="0.0" HorizontalAlignment="Stretch" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    </Grid>
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,0,4,0">
                      <TextBlock Grid.Column="0" Text="Y" VerticalAlignment="Center" Foreground="#51cf66" Margin="0,0,4,0"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding RotY, TargetNullValue=0, FallbackValue=0}" Increment="1" FormatString="0.0" HorizontalAlignment="Stretch" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    </Grid>
                    <Grid Grid.Column="2" ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Text="Z" VerticalAlignment="Center" Foreground="#339af0" Margin="0,0,4,0"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding RotZ, TargetNullValue=0, FallbackValue=0}" Increment="1" FormatString="0.0" HorizontalAlignment="Stretch" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    </Grid>
                  </Grid>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Scale" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="0,0,0,5">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,4,0">
                      <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" Foreground="#ff6b6b" Margin="0,0,4,0"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding ScaleX, TargetNullValue=1, FallbackValue=1}" Increment="0.1" FormatString="0.00" HorizontalAlignment="Stretch" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    </Grid>
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,0,4,0">
                      <TextBlock Grid.Column="0" Text="Y" VerticalAlignment="Center" Foreground="#51cf66" Margin="0,0,4,0"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding ScaleY, TargetNullValue=1, FallbackValue=1}" Increment="0.1" FormatString="0.00" HorizontalAlignment="Stretch" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    </Grid>
                    <Grid Grid.Column="2" ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Text="Z" VerticalAlignment="Center" Foreground="#339af0" Margin="0,0,4,0"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding ScaleZ, TargetNullValue=1, FallbackValue=1}" Increment="0.1" FormatString="0.00" HorizontalAlignment="Stretch" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    </Grid>
                  </Grid>
                </Grid>
              </Expander>

              <!-- Model Component -->
              <Expander Header="Model Component" IsVisible="{Binding HasModel}" IsExpanded="True">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Model ID:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ModelId}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Shadow Mobility:" VerticalAlignment="Center" Margin="0,8,10,0"/>
                  <CheckBox Grid.Row="1" Grid.Column="1" Content="Static Caster" IsChecked="{Binding StaticShadowCaster}" Margin="0,8,0,0"/>
                </Grid>
              </Expander>

              <!-- Camera Component -->
              <Expander Header="Camera" IsVisible="{Binding HasCamera}" IsExpanded="True">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="FOV (Y):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Column="1" Text="{Binding CameraFov, StringFormat=\{0:F2\}}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                </Grid>
              </Expander>

              <Expander Header="Directional Light" IsVisible="{Binding HasDirectionalLight}" IsExpanded="True">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,10,0,0">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Color" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="0,0,0,5">
                    <NumericUpDown Grid.Column="0" Value="{Binding DirectionalLightColorR}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    <NumericUpDown Grid.Column="1" Value="{Binding DirectionalLightColorG}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" Margin="4,0" />
                    <NumericUpDown Grid.Column="2" Value="{Binding DirectionalLightColorB}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                  </Grid>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Intensity" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DirectionalLightIntensity}" Increment="0.25" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Direction" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="0,0,0,5">
                    <NumericUpDown Grid.Column="0" Value="{Binding DirectionalLightDirX}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    <NumericUpDown Grid.Column="1" Value="{Binding DirectionalLightDirY}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" Margin="4,0" />
                    <NumericUpDown Grid.Column="2" Value="{Binding DirectionalLightDirZ}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                  </Grid>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Sun Radius" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto">
                    <NumericUpDown Grid.Column="0" Value="{Binding DirectionalLightAngularRadius}" Increment="0.001" FormatString="0.0000" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    <CheckBox Grid.Column="1" Content="Cast Shadows" IsChecked="{Binding DirectionalLightCastShadows}" Margin="12,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </Expander>

              <Expander Header="Point Light" IsVisible="{Binding HasPointLight}" IsExpanded="True">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,10,0,0">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Color" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="0,0,0,5">
                    <NumericUpDown Grid.Column="0" Value="{Binding PointLightColorR}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    <NumericUpDown Grid.Column="1" Value="{Binding PointLightColorG}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" Margin="4,0" />
                    <NumericUpDown Grid.Column="2" Value="{Binding PointLightColorB}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                  </Grid>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Intensity" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding PointLightIntensity}" Increment="1" FormatString="0.0" behaviors:NumericInputBehavior.IsNumericOnly="True" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Range" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding PointLightRange}" Increment="0.5" FormatString="0.0" behaviors:NumericInputBehavior.IsNumericOnly="True" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Source Radius" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,0">
                    <NumericUpDown Grid.Column="0" Value="{Binding PointLightSourceRadius}" Increment="0.01" FormatString="0.000" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    <CheckBox Grid.Column="1" Content="Cast Shadows" IsChecked="{Binding PointLightCastShadows}" Margin="12,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </Expander>

              <Expander Header="Spot Light" IsVisible="{Binding HasSpotLight}" IsExpanded="True">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,10,0,0">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Color" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="0,0,0,5">
                    <NumericUpDown Grid.Column="0" Value="{Binding SpotLightColorR}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    <NumericUpDown Grid.Column="1" Value="{Binding SpotLightColorG}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" Margin="4,0" />
                    <NumericUpDown Grid.Column="2" Value="{Binding SpotLightColorB}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                  </Grid>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Intensity" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SpotLightIntensity}" Increment="1" FormatString="0.0" behaviors:NumericInputBehavior.IsNumericOnly="True" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Range" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SpotLightRange}" Increment="0.5" FormatString="0.0" behaviors:NumericInputBehavior.IsNumericOnly="True" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Direction" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="0,0,0,5">
                    <NumericUpDown Grid.Column="0" Value="{Binding SpotLightDirX}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    <NumericUpDown Grid.Column="1" Value="{Binding SpotLightDirY}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" Margin="4,0" />
                    <NumericUpDown Grid.Column="2" Value="{Binding SpotLightDirZ}" Increment="0.05" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                  </Grid>

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Cone" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="0,0,0,5">
                    <NumericUpDown Grid.Column="0" Value="{Binding SpotLightInnerCone}" Increment="0.01" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                    <NumericUpDown Grid.Column="1" Value="{Binding SpotLightOuterCone}" Increment="0.01" FormatString="0.00" behaviors:NumericInputBehavior.IsNumericOnly="True" Margin="4,0" />
                    <NumericUpDown Grid.Column="2" Value="{Binding SpotLightSourceRadius}" Increment="0.01" FormatString="0.000" behaviors:NumericInputBehavior.IsNumericOnly="True" />
                  </Grid>

                  <TextBlock Grid.Row="5" Grid.Column="0" Text="Shadows" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <CheckBox Grid.Row="5" Grid.Column="1" Content="Cast Shadows" IsChecked="{Binding SpotLightCastShadows}" VerticalAlignment="Center" />
                </Grid>
              </Expander>

            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border Grid.Row="2" Grid.ColumnSpan="5"
            Background="#1c1f24" Padding="8,4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}"
                   Foreground="#aab0b6"
                   FontSize="12"
                   VerticalAlignment="Center" />
        <Grid Grid.Column="1"
              ColumnDefinitions="Auto,180"
              ColumnSpacing="10"
              IsVisible="{Binding AssetImport.IsActive}">
          <TextBlock Text="{Binding AssetImport.StatusMessage}"
                     Foreground="#d0d4dc"
                     FontSize="11"
                     MaxWidth="360"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <ProgressBar Grid.Column="1"
                       Width="180"
                       Height="4"
                       Value="{Binding AssetImport.Progress}"
                       Maximum="{Binding AssetImport.ProgressMaximum}"
                       IsIndeterminate="{Binding AssetImport.IsIndeterminate}"
                       Foreground="#55d6be"
                       Background="#12151c"
                       VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>

  </Grid>
</Window>
