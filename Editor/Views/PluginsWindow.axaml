<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Engine.Editor.Views.PluginsWindow"
        Width="680"
        Height="520"
        MinWidth="520"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Title="Engine Plugins"
        Background="#121821">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="20,16"
            Background="#171F2A"
            BorderBrush="#2B3848"
            BorderThickness="0,0,0,1">
      <StackPanel Spacing="4">
        <TextBlock Text="ENGINE PLUGINS"
                   FontSize="17"
                   FontWeight="Bold"
                   Foreground="#EAF0F8" />
        <TextBlock Text="Engine modules are project-selectable and hot reload independently."
                   Foreground="#8E9CAD" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Plugins}"
                    Margin="16">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,10"
                    Padding="14"
                    Background="#18212C"
                    BorderBrush="#304052"
                    BorderThickness="1"
                    CornerRadius="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal"
                              Spacing="8">
                    <TextBlock Text="{Binding Name}"
                               Foreground="#EDF3FA"
                               FontWeight="SemiBold"
                               FontSize="14" />
                    <Border Padding="7,2"
                            Background="#243346"
                            CornerRadius="8">
                      <TextBlock Text="{Binding Status}"
                                 Foreground="#55D6BE"
                                 FontSize="10" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}"
                             Foreground="#A3AFBE"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Id}"
                             Foreground="#657487"
                             FontFamily="Menlo,Consolas"
                             FontSize="10" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              Margin="18,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsEnabled}"
                              IsEnabled="{Binding IsToggleable}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Window>
