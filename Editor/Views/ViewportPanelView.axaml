<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Engine.Editor.ViewModels"
             xmlns:views="clr-namespace:Engine.Editor.Views"
             x:Class="Engine.Editor.Views.ViewportPanelView"
             x:CompileBindings="False"
             x:DataType="vm:ViewportPanelViewModel"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="Border.ViewportPill">
      <Setter Property="Background" Value="#202834" />
      <Setter Property="BorderBrush" Value="#364151" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="TextBlock.ViewportLabel">
      <Setter Property="Foreground" Value="#8996A8" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.7" />
    </Style>
  </UserControl.Styles>

  <Border Background="#090D12"
          BorderBrush="#303947"
          BorderThickness="1"
          CornerRadius="10"
          BoxShadow="0 10 26 0 #50000000">
    <Grid RowDefinitions="38,*,28">
      <Border Grid.Row="0"
              Background="#171D26"
              BorderBrush="#303947"
              BorderThickness="0,0,0,1"
              CornerRadius="9,9,0,0"
              Padding="11,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">
            <Border Width="8"
                    Height="8"
                    Background="#55D6BE"
                    CornerRadius="4"
                    BoxShadow="0 0 8 0 #8055D6BE" />
            <TextBlock Classes="ViewportLabel"
                       Text="SCENE VIEW" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="7"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentSceneName}"
                       Foreground="#E4EAF2"
                       FontWeight="SemiBold"
                       MaxWidth="260"
                       TextTrimming="CharacterEllipsis" />
            <Border Width="5"
                    Height="5"
                    Background="#F6C177"
                    CornerRadius="3"
                    IsVisible="{Binding IsDirty}" />
          </StackPanel>
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="6"
                      VerticalAlignment="Center">
            <Border Classes="ViewportPill">
              <ComboBox ItemsSource="{Binding GizmoOperations}"
                        SelectedItem="{Binding SelectedGizmoOperation}"
                        MinWidth="76"
                        Height="22"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Transform gizmo operation" />
            </Border>
            <Border Classes="ViewportPill">
              <ComboBox ItemsSource="{Binding GizmoSpaces}"
                        SelectedItem="{Binding SelectedGizmoSpace}"
                        MinWidth="66"
                        Height="22"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Transform coordinate space" />
            </Border>
            <Border Classes="ViewportPill">
              <ToggleButton IsChecked="{Binding IsGizmoSnapping}"
                            Width="32"
                            Height="22"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="Toggle transform snapping">
                <TextBlock Text="&#xE8F6;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" Foreground="#AEB9C8" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </ToggleButton>
            </Border>
            <Border Classes="ViewportPill">
              <Button MinWidth="112"
                      Height="22"
                      Padding="7,0"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="#AEB9C8"
                      FontSize="10"
                      FontWeight="SemiBold"
                      HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Text="&#xE42A;" FontFamily="avares://Engine.Editor/Assets/MaterialIcons-Regular.ttf#Material Icons" VerticalAlignment="Center" FontSize="14" />
                  <TextBlock Text="{Binding SelectedProjectionMode}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <Border Width="286"
                            Padding="14"
                            Background="#171D26"
                            BorderBrush="#364151"
                            BorderThickness="1"
                            CornerRadius="8">
                      <StackPanel Spacing="12">
                        <TextBlock Text="EDITOR CAMERA"
                                   Classes="ViewportLabel"
                                   Foreground="#AEB9C8" />
                        <ComboBox ItemsSource="{Binding ProjectionModes}"
                                  SelectedItem="{Binding SelectedProjectionMode}"
                                  HorizontalContentAlignment="Center" />
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,Auto">
                          <TextBlock Text="Field of view"
                                     Foreground="#AEB9C8" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding CameraFieldOfView, StringFormat={}{0:0}°}"
                                     Foreground="#55D6BE" />
                          <Slider Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Minimum="15"
                                  Maximum="120"
                                  Value="{Binding CameraFieldOfView}" />
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              IsVisible="{Binding IsOrthographic}">
                          <TextBlock Text="Orthographic size"
                                     Foreground="#AEB9C8" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding OrthographicSize, StringFormat={}{0:0.0}}"
                                     Foreground="#7AA2F7" />
                          <Slider Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Minimum="1"
                                  Maximum="200"
                                  Value="{Binding OrthographicSize}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="Realtime"
                                       Foreground="#E4EAF2"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Render continuously"
                                       Foreground="#7E8A9B"
                                       FontSize="10" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1"
                                        IsChecked="{Binding IsRealtime}"
                                        VerticalAlignment="Center" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Border>
            <Border Classes="ViewportPill">
              <ComboBox ItemsSource="{Binding RendererModes}"
                        SelectedItem="{Binding SelectedRendererMode}"
                        Focusable="False"
                        IsTabStop="False"
                        MinWidth="104"
                        Height="22"
                        Padding="7,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#AEB9C8"
                        FontSize="10"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center" />
            </Border>
            <Border Classes="ViewportPill">
              <Button x:Name="DebugViewButton"
                      Content="{Binding SelectedDebugView}"
                      Focusable="False"
                      IsTabStop="False"
                      MinWidth="116"
                      Height="22"
                      Padding="7,0"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="#AEB9C8"
                      FontSize="10"
                      FontWeight="SemiBold"
                      HorizontalContentAlignment="Center">
                <Button.Flyout>
                  <Flyout>
                    <Border Background="#202834"
                            BorderBrush="#364151"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="5"
                            MinWidth="180">
                      <StackPanel Spacing="4">
                        <ListBox ItemsSource="{Binding DebugViews}"
                                 SelectedItem="{Binding SelectedDebugView}"
                                 SelectionChanged="OnDebugViewSelectionChanged"
                                 Focusable="False"
                                 MaxHeight="360"
                                 Background="Transparent"
                                 BorderThickness="0" />
                        <Border Height="1"
                                Margin="3,2"
                                Background="#364151"
                                IsVisible="{Binding HasDebugViewToggles}" />
                        <ItemsControl ItemsSource="{Binding DebugViewToggles}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <CheckBox Content="{Binding ToggleName}"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        Focusable="False"
                                        Foreground="#D7DEE8"
                                        FontSize="10"
                                        Padding="7,4" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Margin="8,8,8,7"
              Background="#05070A"
              BorderBrush="#343E4C"
              BorderThickness="1"
              CornerRadius="8"
              Padding="1">
        <views:ViewportMetalLayerHost x:Name="MetalHost" />
      </Border>

      <Border Grid.Row="2"
              Background="#111720"
              BorderBrush="#303947"
              BorderThickness="0,1,0,0"
              CornerRadius="0,0,9,9"
              Padding="11,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal"
                      Spacing="14"
                      VerticalAlignment="Center">
            <TextBlock Classes="ViewportLabel"
                       Text="RMB  LOOK"
                       Foreground="#7E8A9B" />
            <TextBlock Classes="ViewportLabel"
                       Text="WASD  MOVE"
                       Foreground="#7E8A9B" />
            <TextBlock Classes="ViewportLabel"
                       Text="LMB  SELECT"
                       Foreground="#7E8A9B" />
          </StackPanel>
          <TextBlock Grid.Column="1"
                     Classes="ViewportLabel"
                     Text="RHI NATIVE SURFACE"
                     Foreground="#647083"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
